# Infra terminates TLS and forwards HTTP to this unprivileged port.
:8080 {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		# The form posts to n8n and may show Turnstile; nothing else leaves the page.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' https: data:; connect-src 'self' https://n8n.kjnet.us; frame-src https://challenges.cloudflare.com; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
	}
	# The creator directory, served live from yipden-app's main branch: the app reads these, and
	# so does the "Is this you?" page. Only the published files, never the test seed. One CORS
	# header, so the app's web build can read them too.
	@directory path /directory/people.json /directory/optouts.json /directory/schema/people.schema.json /directory/schema/optouts.schema.json
	handle @directory {
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=300"
		header -Content-Security-Policy
		reverse_proxy https://raw.githubusercontent.com {
			rewrite /XTREEMMAK/yipden-app/main{uri}
			header_up Host raw.githubusercontent.com
			header_down -Access-Control-Allow-Origin
			header_down -Cache-Control
			header_down -X-Content-Type-Options
			header_down Content-Type "application/json; charset=utf-8"
		}
	}

	try_files {path} {path}.html {path}/
	file_server
}
