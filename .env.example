# Copy to .env for local builds. All three are read at BUILD time and baked into the static site.
SITE_ORIGIN=https://yipden.com
# The n8n webhook the "Is this you?" form posts to. Public, not a secret. Unset: the form is closed.
# REMOVAL_WEBHOOK_URL=https://n8n.example.com/webhook/yipden-directory-request
# Cloudflare Turnstile site key (public). The secret key lives in n8n. Unset: no widget.
# TURNSTILE_SITE_KEY=
# Shown on the closed form. Default jamaal@j2it.us; set it empty to show no address.
# CONTACT_EMAIL=jamaal@j2it.us
