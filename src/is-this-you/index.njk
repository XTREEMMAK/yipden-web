---
layout: base.njk
title: Is this you?
description: Ask for a YipDen directory listing to be removed or corrected.
---
<h1>Is this you?</h1>
<p>
  YipDen's directory lists creators by hand. If you're listed, tell us here: ask to be removed, fix
  something that's wrong, or say it's you and you're happy to be listed. Removals are honoured; no
  reason needed.
</p>
<p id="join" class="join" hidden>
  You have your own website, so you can also
  <a href="https://app.indienodes.us/join">join the IndieNodes ring</a>: members choose to be listed
  and appear in YipDen as IndieNodes members.
</p>

{% if site.removalWebhook %}
<form
  id="request"
  class="request"
  data-webhook="{{ site.removalWebhook }}"
  data-turnstile="{{ site.turnstileSiteKey }}"
  novalidate
>
  <fieldset>
    <legend>What would you like?</legend>
    <label><input type="radio" name="action" value="remove" checked /> Remove my listing</label>
    <label><input type="radio" name="action" value="correct" /> Correct my listing</label>
    <label
      ><input type="radio" name="action" value="confirm" /> Yes, that's me: keep me listed</label
    >
  </fieldset>
  <label for="listing">Your site, profile or handle as listed</label>
  <input id="listing" name="listing" type="text" required autocomplete="url" />
  <input id="listing-id" name="listing_id" type="hidden" />
  <label for="details">Anything we should know (optional)</label>
  <textarea id="details" name="details" rows="4" maxlength="2000"></textarea>
  <label for="contact">Email for a reply (optional)</label>
  <input id="contact" name="contact" type="email" autocomplete="email" />
  <!-- A field people never see: a bot that fills it is dropped by n8n. -->
  <div class="hp" aria-hidden="true">
    <label for="website">Leave this empty</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  {% if site.turnstileSiteKey %}
  <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}"></div>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  {% endif %}
  <button type="submit">Send request</button>
  <p id="status" role="status" aria-live="polite"></p>
</form>
<script src="/assets/js/request.js" type="module"></script>
{% else %}
<p class="closed">
  Requests aren't open on this page yet.{% if site.contactEmail %} Until they are, email
  <a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a>.{% endif %}
</p>
{% endif %}
